{
  "openapi": "3.0.0",
  "info": {
    "title": "API - Sistema Guia de Turismo",
    "description": "Documentação dos endpoints do backend para o aplicativo Flutter.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor Local de Desenvolvimento"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Insira o token JWT gerado no login."
      }
    }
  },
  "paths": {
    "/usuarios": {
      "post": {
        "summary": "Cria um novo usuário",
        "tags": ["Usuários"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string" },
                  "email": { "type": "string" },
                  "senha": { "type": "string" },
                  "avatar": { "type": "string", "nullable": true },
                  "cidade": { "type": "string", "nullable": true },
                  "idade": { "type": "integer", "nullable": true },
                  "profissao": { "type": "string", "nullable": true },
                  "instagram": { "type": "string", "nullable": true },
                  "facebook": { "type": "string", "nullable": true },
                  "youtube": { "type": "string", "nullable": true },
                  "site": { "type": "string", "nullable": true },
                  "telefone": { "type": "string", "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuário criado com sucesso" },
          "400": { "description": "Email já cadastrado" }
        }
      },
      "get": {
        "summary": "Lista todos os usuários",
        "tags": ["Usuários"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Lista retornada com sucesso" },
          "401": { "description": "Não autorizado (Token ausente ou inválido)" }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Faz login e retorna o Token JWT",
        "tags": ["Autenticação"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "senha": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login efetuado com sucesso (Retorna o Token)" },
          "401": { "description": "Credenciais incorretas" }
        }
      }
    },
    "/categorias": {
      "get": {
        "summary": "Lista todas as categorias",
        "tags": ["Categorias"],
        "responses": {
          "200": { "description": "Lista de categorias" }
        }
      }
    },
    "/lugares": {
      "get": {
        "summary": "Lista os lugares (com paginação)",
        "tags": ["Lugares"],
        "parameters": [
          {
            "in": "query",
            "name": "pagina",
            "schema": { "type": "integer" },
            "description": "Número da página"
          },
          {
            "in": "query",
            "name": "limite",
            "schema": { "type": "integer" },
            "description": "Quantidade de itens por página"
          }
        ],
        "responses": {
          "200": { "description": "Lista de lugares" }
        }
      }
    },
    "/favoritos": {
      "get": {
        "summary": "Lista os lugares favoritos do usuário logado",
        "tags": ["Favoritos"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Lista de lugares favoritos" },
          "401": { "description": "Não autorizado" }
        }
      }
    },
    "/favoritos/{lugarId}": {
      "post": {
        "summary": "Adiciona um lugar aos favoritos",
        "tags": ["Favoritos"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "lugarId",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "201": { "description": "Lugar favoritado com sucesso" }
        }
      },
      "delete": {
        "summary": "Remove um lugar dos favoritos",
        "tags": ["Favoritos"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "lugarId",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Removido com sucesso" }
        }
      }
    }
  }
}
